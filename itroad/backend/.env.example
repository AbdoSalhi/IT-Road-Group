# --- Database ---
# Default: local SQLite file (backend/itroad.db). Fine for the prototype/local run.
# For Postgres, use e.g.: postgresql+psycopg2://user:password@localhost:5432/itroad
DATABASE_URL=sqlite:///./itroad.db

# --- CORS ---
# Comma-separated list of origins allowed to call this API (your frontend dev/prod URL(s))
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Admin dashboard ---
# Shared-secret token required in the "X-Admin-Token" header to reach /api/admin/*.
# Generate one yourself, e.g.: python -c "import secrets; print(secrets.token_hex(24))"
ADMIN_TOKEN=change-me-before-running

# --- AI chatbot (Ollama, local only - no paid API keys) ---
# Base URL of your local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434
# Chat model used to answer visitors and extract lead-qualification data.
# Pull it first: ollama pull llama3.1:8b
OLLAMA_CHAT_MODEL=llama3.1:8b
# Embedding model used to build/search the website-knowledge vector index.
# Pull it first: ollama pull nomic-embed-text
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Optional timeouts (seconds)
OLLAMA_CHAT_TIMEOUT=90
OLLAMA_EMBED_TIMEOUT=30
